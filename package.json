{
  "name": "@monotykamary/pi-opencode-provider",
  "version": "1.0.39",
  "description": "Opencode provider extension for pi - Access GPT, Claude, Gemini, GLM, MiniMax, Kimi and more through the opencode.ai API",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "clean": "echo 'nothing to clean'",
    "build": "echo 'nothing to build'",
    "check": "tsc --noEmit && node scripts/test-pi-compat.mjs",
    "update-models": "node scripts/update-models.js",
    "test:pi": "node scripts/test-pi-compat.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "pi",
    "extension",
    "provider",
    "opencode",
    "ai",
    "llm",
    "gpt",
    "claude",
    "gemini"
  ],
  "author": "",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "typescript": "6.0.3",
    "@types/node": "^25.9.1",
    "@earendil-works/pi-ai": "1.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*"
  }
}
